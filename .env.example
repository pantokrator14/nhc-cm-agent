# 1. Google Gemini API (Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# 2. Google Drive (Service Account JSON & carpeta raíz "NELHEALTHCOACH Publicaciones")
GOOGLE_APPLICATION_CREDENTIALS=./credentials/service_account.json
DRIVE_ROOT_FOLDER_ID=your_drive_root_folder_id_here
# Opcional: email de Google Workspace a impersonar si la Service Account usa Domain-Wide Delegation (ej. ceo@nelhealthcoach.com)
GOOGLE_DRIVE_IMPERSONATE_EMAIL=
# Opcional: ruta a token OAuth 2.0 de usuario (authorized_user JSON) si no se usa Unidad Compartida ni Delegación
GOOGLE_OAUTH_CREDENTIALS=

# 3. Telegram Bot (Human-in-the-Loop, directo en el chat del bot sin crear grupo)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Chat ID privado con el bot del administrador principal (cada admin puede obtener su ID con /id)
TELEGRAM_ADMIN_CHAT_ID=123456789
# Chat IDs privados con el bot de los otros dos administradores separados por coma (ej. 111111,222222)
TELEGRAM_EXTRA_ADMIN_CHAT_IDS=

# 4. Meta / Instagram Graph API v21.0
META_ACCESS_TOKEN=your_meta_long_lived_access_token_here
IG_USER_ID=your_instagram_business_user_id_here
# Opcional: App ID y App Secret de Meta (para debug/extensión automática del token)
META_APP_ID=
META_APP_SECRET=
# Opcional: IDs fijos de Página/Lugar en Facebook para alternar ubicación (si se dejan vacíos se buscan automáticamente)
META_LOCATION_ID_US=
META_LOCATION_ID_CA=
# Opcional: cuenta publicitaria para promociones automáticas (ej. act_657099399093031)
META_AD_ACCOUNT_ID=
# Nombre del público guardado en Meta Ads Manager (por defecto: mujeres)
META_SAVED_AUDIENCE_NAME=mujeres

# 5. TikTok Content Posting API v2 (@nelhealtcoachoficial - solo publicación orgánica de videos)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REFRESH_TOKEN=
TIKTOK_ACCESS_TOKEN=
# DIRECT (publica directo si la app está auditada) o INBOX (envía a borradores de TikTok)
TIKTOK_PUBLISH_MODE=DIRECT
# PUBLIC_TO_EVERYONE | MUTUAL_FOLLOW_FRIENDS | FOLLOWER_OF_CREATOR | SELF_ONLY
TIKTOK_PRIVACY_LEVEL=PUBLIC_TO_EVERYONE

# 6. Webhook Nativo FastAPI para Instagram (DM + Respuesta pública)
WEBHOOK_VERIFY_TOKEN=nelhealthcoach_verify_2026
WEBHOOK_PORT=8000
